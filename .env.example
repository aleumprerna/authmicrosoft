MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret-value
# Use "common" for work/school and personal Microsoft accounts, or use your tenant ID.
MICROSOFT_TENANT_ID=common
# Local Flask port. Use a free port if Windows or another app blocks this one.
PORT=8000
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback
# Generate a long random value, for example: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-value
# Used to encrypt Microsoft tokens stored in SQLite. Keep this value unchanged.
TOKEN_ENCRYPTION_KEY=replace-with-another-long-random-value
DATABASE_PATH=accounts.db

# Optional: public HTTPS URL for open/click tracking. Email still sends via Microsoft.
# Example: https://your-host.trycloudflare.com (keep this URL running after sending).
TRACKING_PUBLIC_BASE_URL=
